(define-record-type <RepodbSchemeAlphaEntityV1>
  (make-RepodbSchemeAlphaEntityV1 id name active)
  RepodbSchemeAlphaEntityV1?
  (id entity-id)
  (name entity-name)
  (active entity-active))
(define-record-type <audit-event>
  (make-audit-event entity-id action)
  audit-event?
  (entity-id audit-entity-id)
  (action audit-action))
(define (make-registry) (vector '() '()))
(define (registry-add registry value)
  (vector-set! registry 0 (cons value (vector-ref registry 0)))
  (vector-set! registry 1 (cons (make-audit-event (entity-id value) 'create) (vector-ref registry 1)))
  registry)
(define (registry-find registry id)
  (find (lambda (value) (= (entity-id value) id)) (vector-ref registry 0)))
(define (registry-archive registry id)
  (vector-set! registry 0 (filter (lambda (value) (not (= (entity-id value) id))) (vector-ref registry 0)))
  (vector-set! registry 1 (cons (make-audit-event id 'archive) (vector-ref registry 1))))
